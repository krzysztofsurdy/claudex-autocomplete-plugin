<idea-plugin>
  <id>dev.ksurdy.claudeautocomplete</id>
  <name>Claude Autocomplete</name>
  <vendor>ksurdy</vendor>
  <description>Copilot-style inline completion powered by the local Claude Code CLI and your Claude subscription.</description>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <inline.completion.provider implementation="dev.ksurdy.claudeautocomplete.ClaudeInlineCompletionProvider"/>
    <applicationConfigurable parentId="tools"
                             instance="dev.ksurdy.claudeautocomplete.ClaudeAutocompleteConfigurable"
                             id="claude.autocomplete.settings"
                             displayName="Claude Autocomplete"/>
    <statusBarWidgetFactory id="ClaudeAutocompleteStatus"
                            implementation="dev.ksurdy.claudeautocomplete.ui.ClaudeStatusBarWidgetFactory"/>
    <notificationGroup id="Claude Autocomplete" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="ClaudeAutocomplete.Toggle"
            class="dev.ksurdy.claudeautocomplete.actions.ToggleAction"
            text="Toggle Claude Autocomplete"
            description="Enable or disable Claude inline completions">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="ClaudeAutocomplete.Trigger"
            class="dev.ksurdy.claudeautocomplete.actions.TriggerAction"
            text="Trigger Claude Completion"
            description="Request an inline completion from Claude">
      <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt BACK_SLASH"/>
    </action>
  </actions>
</idea-plugin>
