<idea-plugin>
  <id>dev.ksurdy.claudeautocomplete</id>
  <name>Claudex Autocomplete</name>
  <vendor>ksurdy</vendor>
  <description>Copilot-style inline completion powered by the local Claude Code CLI or Codex CLI, using your Claude or ChatGPT subscription. No API key needed.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="claude-autocomplete-php.xml">com.jetbrains.php</depends>

  <extensionPoints>
    <extensionPoint name="importedClassesProvider"
                    interface="dev.ksurdy.claudeautocomplete.ImportedClassesProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <inline.completion.provider implementation="dev.ksurdy.claudeautocomplete.ClaudeInlineCompletionProvider"/>
    <applicationConfigurable parentId="tools"
                             instance="dev.ksurdy.claudeautocomplete.ClaudeAutocompleteConfigurable"
                             id="claude.autocomplete.settings"
                             displayName="Claudex Autocomplete"/>
    <statusBarWidgetFactory id="ClaudeAutocompleteStatus"
                            implementation="dev.ksurdy.claudeautocomplete.ui.ClaudeStatusBarWidgetFactory"/>
    <notificationGroup id="Claude Autocomplete" displayType="BALLOON" icon="/icons/claudex.svg"/>
  </extensions>

  <actions>
    <action id="ClaudeAutocomplete.Toggle"
            class="dev.ksurdy.claudeautocomplete.actions.ToggleAction"
            text="Toggle Claudex Autocomplete"
            icon="dev.ksurdy.claudeautocomplete.ClaudexIcons.Logo"
            description="Enable or disable Claudex inline completions">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="ClaudeAutocomplete.Trigger"
            class="dev.ksurdy.claudeautocomplete.actions.TriggerAction"
            text="Trigger Claudex Completion"
            icon="dev.ksurdy.claudeautocomplete.ClaudexIcons.Logo"
            description="Request an inline completion from Claude Code or Codex">
      <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt BACK_SLASH"/>
    </action>
  </actions>
</idea-plugin>
